      },
      "item": [
        {
          "id": "64eebca5-2ac0-43a9-89eb-14a5b2d190b5",
          "name": "Retrieve available product releases",
          "request": {
            "name": "Retrieve available product releases",
            "description": {
              "content": "Retrieve a list of release versions available for each product. The response returns information such as the unique ID of the product, the latest release version, and when the latest release version of the product will automatically be activated. Sometimes, the previous and latest versions are the same.\n\n <br>**Note:** <em>This API is in **alpha**. While in alpha, APIs may change in a breaking way without notice; functionality may be removed, and no deprecation notices will be issued.\n If you are interested in using this API, please contact your Customer Success Manager (CSM).</em>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1alpha",
                "admin",
                "product",
                "releases"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
