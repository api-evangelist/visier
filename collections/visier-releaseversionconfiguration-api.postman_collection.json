          "id": "ba7ac27e-1a4d-4e80-8ec7-bf3640547b79",
          "name": "Activate product release versions",
          "request": {
            "name": "Activate product release versions",
            "description": {
              "content": "Set the product release version to activate it on the selected tenants. Analytic tenants will automatically inherit the release version from the administrating tenant. You cannot rollback to a previous version.\n\n <br>**Note:** <em>This API is in **alpha**. While in alpha, APIs may change in a breaking way without notice; functionality may be removed, and no deprecation notices will be issued.\n If you are interested in using this API, please contact your Customer Success Manager (CSM).</em>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1alpha",
                "admin",
                "product",
                "versions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PATCH",
            "auth": null,
