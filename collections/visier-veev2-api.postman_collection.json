          "id": "e59a7946-7b22-41f2-bda8-8b37d731612c",
          "name": "Retrieve a list of sample questions to ask Vee",
          "request": {
            "name": "Retrieve a list of sample questions to ask Vee",
            "description": {
              "content": "Get a list of sample questions to help you start using Vee. The response returns a list of questions that you can ask Vee, such as \"What is the turnover rate?\".\n You may occasionally encounter a sample question that can't be answered due to data availability or your data access",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "vee",
                "sample-questions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "Optionally, specify the tenant that you want to execute the API call on. This defines the tenant that you're logged into. If omitted, the request uses the administrating tenant as the login tenant.",
