        {
          "id": "8e663576-1f85-4f1e-a6c7-d51985986d89",
          "name": "Import a list of sources",
          "request": {
            "name": "Import a list of sources",
            "description": {
              "content": "Import a list of sources in ZIP format. The file must be an export from `POST /v1beta/admin/sources`. Use this API after making changes in a development environment to copy the changes to your production environment.\n\n<br>**Note:** <em>This API is in **beta**. While in beta, APIs are interface-stable and implementation may change without notice. Rarely, interface changes may occur that are not backwards-compatible and require advance communication.\nIf you are interested in using this API, please contact your Customer Success Manager (CSM).</em>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1beta",
                "admin",
                "sources"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "replaceAllExistingSources",
                  "value": "<boolean>",
                  "description": "If `false`, adds the sources from the ZIP to the sources in the target tenant. If `true`, removes all sources in the target tenant and adds the sources from the ZIP. Default is `false`."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "Optionally, specify the tenant that you want to execute the API call on. This defines the tenant that you're logged into. If omitted, the request uses the administrating tenant as the login tenant.",
                "key": "TargetTenantID",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/zip"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "file"
            }
          },
