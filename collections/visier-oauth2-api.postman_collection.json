  "item": [
    {
      "id": "3d9cc213-d1ae-4cf8-b8f7-064285c303af",
      "name": "OAuth2",
      "description": {
        "content": "Request an authentication token through OAuth 2.0 with Open ID Connect (OIDC). With OAuth 2.0 with OIDC, use an OAuth 2.0 grant to request an authentication token. \nThe response returns a JSON Web Token (JWT) that you can use in your API calls.",
        "type": "text/plain"
      },
      "item": [
