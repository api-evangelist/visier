        {
          "id": "086c346b-deba-429f-90aa-81f4bd85255a",
          "name": "Request an authorization code",
          "request": {
            "name": "Request an authorization code",
            "description": {
              "content": "Request an authorization code for the authorization_code grant type. Not required in other OAuth 2.0 grant types.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "auth",
                "oauth2",
                "authorize"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<string>",
                  "description": "The optional URI to redirect to after authorization."
                },
                {
                  "disabled": false,
                  "key": "response_type",
                  "value": "<string>",
                  "description": "(Required) The response type. Must be `code`."
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) The ID of the pre-registered client application."
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "The OAuth 2.0 scope of the authorization request. Default is `read`. If the scope includes `visier:login:bypass_users`, then the redirect login URL ends in \"/auth/admin\" instead of \"/auth\". This allows single sign-on (SSO) Bypass Users to login through Visier instead of being redirected to the SSO login page."
                }
              ],
              "variable": []
