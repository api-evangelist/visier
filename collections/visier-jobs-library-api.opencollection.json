{
  "opencollection": "1.0.0",
  "info": {
    "name": "Skills Intelligence Engine Jobs Library API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Jobs Library",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get job details by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/jobs/:id",
            "headers": [
              {
                "name": "Accept-Language",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the job to retrieve details for.\n"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "If you know the ID of a job, use this endpoint to retrieve information such as display name, description, Automation Index, Remote Work Index, alternative names, and skills.\n"
        },
        {
          "info": {
            "name": "Retrieve a list of jobs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/jobs",
            "headers": [
              {
                "name": "Accept-Language",
                "value": ""
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Use this endpoint to retrieve all the jobs in Visier's Jobs Library.\n"
        },
        {
          "info": {
            "name": "Search jobs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/jobs/search",
            "headers": [
              {
                "name": "Accept-Language",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "term",
                "value": "",
                "type": "query",
                "description": "The term to search for. The search term must be URL encoded and the minimum length is 3 characters.\n"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve a list of jobs that match a specified search term.\n"
        },
        {
          "info": {
            "name": "Standardize custom job titles",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/jobs/standardize",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Find the top standardized job matches for any custom job title and optional NAICS code.\n"
        }
      ]
    }
  ],
  "bundled": true
}