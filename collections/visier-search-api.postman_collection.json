      "item": [
        {
          "id": "e207c631-d136-4e24-afd6-aac21b3b2f55",
          "name": "Perform a simple search for Visier document headers",
          "request": {
            "name": "Perform a simple search for Visier document headers",
            "description": {
              "content": "Perform a simple search for Visier document headers, such as analysis titles. Simple search doesn't support keywords, Boolean expressions, or any other advanced search features.\n Example: `GET /v1alpha/search/simple/document-headers?q=My+Query&limit=10` returns the first 10 document headers that best match the query string `My Query`.\n\n <br>**Note:** <em>This API is in **alpha**. While in alpha, APIs may change in a breaking way without notice; functionality may be removed, and no deprecation notices will be issued.\n If you are interested in using this API, please contact your Customer Success Manager (CSM).</em>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1alpha",
                "search",
                "simple",
                "document-headers"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "The search query string. The results include document headers that match the search string. Search string is case-insensitive and supports partial matches. Search string must be at least 2 characters up to a maximum of 200 characters."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "The maximum number of results to return. Defaults to 100."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "The index to start retrieving results from, also known as offset. Defaults to 0."
