      "name": "PlanAdministration",
      "description": {
        "content": "Manage collaboration projects in your plans, including actions such as consolidating and reopening subplans.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "1292dcfd-1b9a-492f-93af-6df11cc5f308",
          "name": "Partially update a plan",
          "request": {
            "name": "Partially update a plan",
            "description": {
              "content": "Make partial changes to existing plans. The response returns whether each plan was successfully patched or not. When patching objects, we recommend that you first retrieve the object definition using `GET`. You can use the `GET` response in your `PATCH` request definition. To retrieve main plan or subplan IDs, see `GET /v1/planning/model/plans`. If the response includes a `parentPlanUuid`, then the plan is a subplan. Use `PATCH` to change specific fields in the plan without affecting omitted fields.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "planning",
                "data",
                "plans",
                ":planId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "planId",
                  "description": "(Required) The unique identifier of the plan."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PATCH",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shareActionPayload\": {\n    \"shares\": [\n      {\n        \"username\": \"<string>\",\n        \"accessRight\": \"<enum>\"\n      },\n      {\n        \"username\": \"<string>\",\n        \"accessRight\": \"<enum>\"\n      }\n    ],\n    \"comment\": \"<string>\",\n    \"notifyRecipients\": \"<boolean>\"\n  }\n}",
