        {
          "id": "08e4de67-f97c-4fb4-b6e4-600abd190fda",
          "name": "Partially update a plan scenario",
          "request": {
            "name": "Partially update a plan scenario",
            "description": {
              "content": "Make partial changes to a scenario in an existing plan. The response returns whether the scenario was successfully patched or not. When patching objects, we recommend that you first retrieve the object definition using `GET`. You can use the `GET` response in your `PATCH` request definition. To retrieve plan IDs and scenario IDs, see `GET /v1/planning/model/plans`. If the response includes a `parentPlanUuid`, then the plan is a subplan.\n\n Use `PATCH` to change specific fields in the scenario without affecting omitted fields.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "planning",
                "data",
                "plans",
                ":planId",
                "scenarios",
                ":scenarioId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "planId",
                  "description": "(Required) The unique identifier of the main plan or subplan. Use the main plan ID for consolidating, starting collaboration, or ending collaboration. Otherwise, use the subplan ID."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "scenarioId",
                  "description": "(Required) The unique identifier of the plan scenario."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PATCH",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actionType\": \"<string>\",\n  \"consolidateActionPayload\": {\n    \"autoRollup\": \"<boolean>\",\n    \"includedSubPlans\": [\n      \"<string>\",\n      \"<string>\"\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
