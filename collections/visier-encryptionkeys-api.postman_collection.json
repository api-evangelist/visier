                "admin",
                "encryption-keys",
                ":keyName"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "keyName",
                  "description": "(Required) The encryption key's display name. The name may only contain alphanumeric or dash (-) characters and must be between 3 and 36 characters long."
