          "name": "Get base salary benchmark value",
          "request": {
            "name": "Get base salary benchmark value",
            "description": {
              "content": "Retrieve the base salary benchmark value.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "compensation-benchmarks",
                "base-salary"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "job",
                  "value": "<string>",
                  "description": "(Required) The job member ID.\n"
                },
                {
                  "disabled": false,
                  "key": "industry",
                  "value": "<string>",
                  "description": "The industry member ID. If the ID is not provided, the response returns the benchmark value across all industries.\n"
                },
                {
                  "disabled": false,
                  "key": "naicsCode",
                  "value": "<string>",
                  "description": "The North American Industry Classification System (NAICS) code. \n\nIf the NAICS code is not provided, the response returns the benchmark value across all industries.\nIf both `naicsCode` and `industry` are provided, the response returns the benchmark value for the `industry` parameter. The entered `naicsCode` will not be applied.\n"
                },
                {
                  "disabled": false,
                  "key": "location",
                  "value": "<string>",
                  "description": "The location member ID. If the ID is not provided, the response returns the benchmark value across all locations.\n"
                },
                {
                  "disabled": false,
                  "key": "companySize",
                  "value": "<string>",
                  "description": "The company size member ID. If the ID is not provided, the response returns the benchmark value across all company sizes.\n"
                },
                {
                  "disabled": false,
                  "key": "careerLevel",
                  "value": "<string>",
                  "description": "The career level member ID. If the ID is not provided, the response returns the benchmark value across all career levels.\n"
                },
                {
                  "disabled": false,
                  "key": "matchDate",
                  "value": "<string>",
                  "description": "The date on which the career level was matched in `yyyy-MM-dd` format. A `matchDate` allows precise migration of career levels according to job architecture changes released since the match was made. If `matchDate` is not available, the migration assumes the most recent possible match date for the provided career level.\n"
                }
              ],
              "variable": []
            },
