        {
          "id": "22150a07-b0e4-43bc-9cf6-6dac0808eca4",
          "name": "Request an impersonation token",
          "request": {
            "name": "Request an impersonation token",
            "description": {
              "content": "Generate an impersonation token for the given username. The requesting user must have the Impersonator profile. The impersonated user must have the Read Impersonated or Write Impersonated profile. Supports impersonating users within the same tenant or in an analytic tenant by specifying a`TargetTenantID`. After receiving the token, use the header `Cookie:VisierImpersonationToken` to make API requests as the impersonated user.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "admin",
                "visierImpersonationToken"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "write",
                  "value": "<boolean>",
                  "description": "If `true`, the token grants read and write impersonation. The impersonated user must have the WriteImpersonated profile capability. Default is `false` and grants read only impersonation."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "The tenant ID to execute the call on.",
                "key": "TargetTenantID",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "The username of the user to impersonate. If provided in both the header and the request body, the header value takes precedence.",
                "key": "TargetUsername",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "apikey"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "TargetUsername",
                  "value": "<string>",
                  "description": "The username of the user to impersonate."
                }
              ]
            }
          },
          "response": [
            {
              "id": "1189e222-430c-4be3-87e6-a6c9ba0256a1",
              "name": "Returns an impersonation request token in plain text and as the VisierImpersonationToken cookie. Use the token to execute API requests as the impersonated user.",
              "originalRequest": {
