      "id": "07136ee9-7154-4dd8-8084-240234c330b4",
      "name": "BasicAuthentication",
      "description": {
        "content": "Request an authentication token through basic authentication. With basic authentication, use your username and password to request a secure token. The response returns an ASID token that you can use in your API calls.",
        "type": "text/plain"
      },
